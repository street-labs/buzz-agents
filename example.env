# Example agent config for agent-watcher.sh.
# Copy to ~/.buzz/agents/<name>.env, edit, and launch:
#   tmux new-session -d -s buzz-<name> '~/.buzz/agents/agent-watcher.sh ~/.buzz/agents/<name>.env'

# --- Required ---
AGENT_NAME="myproject"                                   # agent identity; bot is @myproject in channels
AGENT_KEY_FILE="$HOME/.buzz/agents/myproject-bot.key"    # bot private key (nsec hex), minted by new-agent.sh
AGENT_REPO="$HOME/code/myproject"                        # repo the agent works in
AGENT_HARNESS="pi"                                       # claude | pi | goose
AGENT_MODEL="glm-5.3"                                    # NO default - must be explicit (cost control)

# --- Git guardrail ---
# branch-pr (default): work on branch agent/<name>, open PRs, never touch main.
# direct-main: single-writer repo, commit straight to main and push.
AGENT_GUARDRAIL="branch-pr"

# --- Prompts ---
AGENT_BASE_PROMPT_FILE="$HOME/.buzz/agents/base-agent-prompt.md"   # shared operating rules
# AGENT_PERSONA_FILE="$HOME/.buzz/agents/myproject-persona.md"     # optional per-agent personality

# --- Channel behavior ---
# Space-separated channel ids where this agent is PRIMARY (follows threads).
# In every other channel it is a member of, it is summon-only: answers a direct
# @mention, then bows out. Channels not listed are summon-only by default.
# AGENT_HOME_CHANNELS="uuid1 uuid2"

# --- Tuning (defaults shown) ---
# MAX_WORKERS=8        # max concurrent harness sessions
# MODEL_TIMEOUT=600    # seconds before a hung model call is killed
# BOOT_GRACE=600       # on restart, suppress history older than this many seconds
# AGENTS_DIR="$HOME/.buzz/agents"   # runtime state root
